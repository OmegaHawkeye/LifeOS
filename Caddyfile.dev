{
	auto_https off
}

https://julians-macbook-pro.tail8a9611.ts.net:8443 {
	tls .local-https/julians-macbook-pro.tail8a9611.ts.net.pem .local-https/julians-macbook-pro.tail8a9611.ts.net-key.pem

	handle /api/* {
		reverse_proxy 127.0.0.1:8000
	}

	handle /sanctum/* {
		reverse_proxy 127.0.0.1:8000
	}

	# The management page is a frontend SPA route; only the Laravel passkey
	# endpoints below it belong on the backend.
	handle /passkeys/manage* {
		reverse_proxy 127.0.0.1:5173
	}

	handle /passkeys/* {
		reverse_proxy 127.0.0.1:8000
	}

	handle /user/* {
		reverse_proxy 127.0.0.1:8000
	}

	handle {
		reverse_proxy 127.0.0.1:5173
	}
}
