{
  "name": "mobile",
  "version": "0.11.0",
  "main": "index.ts",
  "dependencies": {
    "@lifeos/ui": "workspace:*",
    "expo": "~57.0.24",
    "expo-build-properties": "~57.0.21",
    "expo-crypto": "~57.0.3",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "tailwindcss": "^4.3.3",
    "uniwind": "^1.12.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest --runInBand",
    "typecheck": "tsc --noEmit",
    "build:ios": "expo export --platform ios"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/*.test.ts",
      "**/*.test.tsx"
    ],
    "moduleNameMapper": {
      "^react$": "<rootDir>/node_modules/react",
      "^react/(.*)$": "<rootDir>/node_modules/react/$1",
      "^@lifeos/ui/button$": "<rootDir>/../ui/src/Button.native.tsx",
      "^@lifeos/ui$": "<rootDir>/../ui/src/SummaryCard.native.tsx",
      "^@lifeos/ui/icons$": "<rootDir>/../ui/src/AppIcon.native.tsx",
      "^@lifeos/ui/tag$": "<rootDir>/../ui/src/Tag.native.tsx",
      "^@lifeos/ui/meter$": "<rootDir>/../ui/src/Meter.native.tsx",
      "^@lifeos/ui/signal-card$": "<rootDir>/../ui/src/SignalCard.native.tsx",
      "^@lifeos/ui/segmented-control$": "<rootDir>/../ui/src/SegmentedControl.native.tsx",
      "^@lifeos/ui/switch$": "<rootDir>/../ui/src/Switch.native.tsx",
      "^@lifeos/ui/app-nav$": "<rootDir>/../ui/src/AppNav.native.tsx",
      "^@lifeos/ui/tokens$": "<rootDir>/../ui/src/nativeTokens.ts",
      "\\.css$": "<rootDir>/src/test/styleMock.js"
    }
  }
}
